# index.html must never be cached or a stale shell points at a dead bundle.
# Hashed assets, fonts and footage are immutable and cached for a year.
/
  Cache-Control: max-age=0, must-revalidate
/index.html
  Cache-Control: max-age=0, must-revalidate
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
# Footage filenames are stable, so revving a clip means replacing the file.
# A month is the compromise between repeat-visit cost and a stale reel.
/media/*
  Cache-Control: public, max-age=2592000
