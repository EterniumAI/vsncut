# index.html must never be cached or a stale shell points at a dead bundle.
# Hashed assets and fonts are immutable and cached for a year.
#
# There is no /media/* rule here any more: the footage is served from the
# vsncut-media R2 bucket via media.vsncut.com, which sets its own immutable
# cache-control AND answers Range requests. Cloudflare Pages does not, which is
# why the video moved off it. See src/lib/media.ts.
/
  Cache-Control: max-age=0, must-revalidate
/index.html
  Cache-Control: max-age=0, must-revalidate
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/og.jpg
  Cache-Control: public, max-age=86400
