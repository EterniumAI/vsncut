---
import '../styles/tokens.css';
import '../styles/base.css';
import NavBar from '../components/NavBar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { hex, type SiteMeta } from '../lib/content';

interface Props { site?: SiteMeta }
const { site = {} } = Astro.props;

const name = site.name?.trim() || 'VSN CUT';
const title = site.seo?.title?.trim() || 'VSN CUT / Video production and social, Salt Lake City';
const description =
  site.seo?.description?.trim() ||
  'Cinematic video production and social media management under one roof. Salt Lake City, Utah.';
// Link previews need an ABSOLUTE url; a root-relative path renders as a broken
// card on every platform that unfurls. Astro.url is the real request url under
// SSR, so this resolves correctly on the pages.dev preview and on vsncut.com
// without hardcoding either. A CentraMind-published og_image wins if set.
const ogImage = site.seo?.og_image?.trim() || new URL('/og.jpg', Astro.url).href;
const ogImageAlt = 'VSN CUT. Video that brings customers. Not just views.';

// Runtime brand overrides are written as inline CSS vars on <body> so they
// cascade past Astro's scoped styles. Guarded: a non-hex value is dropped
// rather than emitted, so a bad row can never inject into the style attribute.
const t = site.theme ?? {};
const vars = [
  hex(t.bg) ? `--surface-page:${hex(t.bg)}` : '',
  hex(t.accent) ? `--accent:${hex(t.accent)}` : '',
  hex(t.primary) ? `--text-accent:${hex(t.primary)}` : '',
].filter(Boolean).join(';');

const ld = {
  '@context': 'https://schema.org',
  '@type': 'VideoProductionCompany',
  name: 'VSN CUT',
  description,
  email: 'austin@vsncut.com',
  telephone: '+1-801-865-5585',
  address: { '@type': 'PostalAddress', addressLocality: 'Salt Lake City', addressRegion: 'UT', addressCountry: 'US' },
  founder: { '@type': 'Person', name: 'Austin Schroader' },
};
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0A0A0B" />
    <link rel="canonical" href={Astro.url.href} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600&family=Bebas+Neue&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <script>
    // One soundtrack at a time, enforced for the whole page.
    //
    // Each component policed audio only within itself, so the three audible
    // surfaces could stack: press play on the featured film, tap a reel to
    // unmute it, then open a work card's lightbox and all three run at once.
    // FeaturedFilm has no script of its own, so this cannot live in a
    // component; it has to be here.
    //
    // Capture phase because 'play' does not bubble. Muted elements are ignored
    // on purpose: the hero montage, the hover loops and the resting reels are
    // silent decoration and must keep running underneath whatever is audible.
    document.addEventListener(
      'play',
      (e) => {
        const el = e.target as HTMLMediaElement;
        if (!(el instanceof HTMLMediaElement) || el.muted) return;
        document.querySelectorAll<HTMLMediaElement>('video, audio').forEach((other) => {
          if (other === el || other.paused || other.muted) return;
          other.pause();
          // A reel carries its mute state in the UI, so put it back rather
          // than leaving a card claiming "Sound on" over a paused video.
          const card = other.closest('[data-reel]');
          if (card) {
            other.muted = true;
            card.classList.remove('is-live');
            card.setAttribute('aria-pressed', 'false');
            const flag = card.querySelector('[data-audio-flag]');
            if (flag) flag.textContent = 'Sound off';
            other.play().catch(() => {});
          }
        });
      },
      true
    );
  </script>
  <body style={vars}>
    <NavBar />
    <main><slot /></main>
    <SiteFooter />
  </body>
</html>
