---
import Base from '../layouts/Base.astro';
import SectionRenderer from '../components/SectionRenderer.astro';
import ZoomHero from '../components/ZoomHero.astro';
import WorkGrid from '../components/WorkGrid.astro';
import FeaturedFilm from '../components/FeaturedFilm.astro';
import SocialStrip from '../components/SocialStrip.astro';
import { media, type WorkItem, type Reel } from '../lib/media';
import { getContent } from '../lib/content';

const content = await getContent();
const live = !!content?.site?.live && (content?.sections?.length ?? 0) > 0;

// The designed home page, shown until sections are published in CentraMind.
//
// Everything here is verified, not filler. Every clip is real client work cut
// from the masters Austin supplied, and a `client` is named ONLY where the
// business appears on screen in the footage itself. The design system is
// explicit: never fabricate a metric, testimonial, review count or award,
// because none exist publicly for this business. So there are no invented
// client logos and no made-up numbers.
//
// Ordering is a sales decision, not an archive: the two pieces that read most
// clearly as "this made someone money" lead, craft follows, and the long-form
// documentary work anchors the back half.
const work: WorkItem[] = [
  {
    key: 'kennethboggs',
    title: 'Kenneth Boggs',
    client: 'Custom By Kenneth Boggs',
    tag: 'Commercial',
    year: '2025',
    loop: media('work/kennethboggs.mp4'),
    poster: media('posters/kennethboggs.jpg'),
    full: media('full/kennethboggs.mp4'),
  },
  {
    key: 'hhc',
    title: 'Houston TX Hot Chicken',
    client: 'Houston TX Hot Chicken',
    tag: 'Brand campaign',
    loop: media('work/hhc.mp4'),
    poster: media('posters/hhc.jpg'),
    full: media('full/hhc.mp4'),
  },
  {
    key: 'carpa',
    title: 'An Evening with Carpa',
    tag: 'Short film',
    loop: media('work/carpa.mp4'),
    poster: media('posters/carpa.jpg'),
    full: media('featured/carpa-film.mp4'),
  },
  {
    key: 'absoluteflight',
    title: 'Absolute Flight',
    client: 'Absolute Flight',
    tag: 'Documentary',
    loop: media('work/absoluteflight.mp4'),
    poster: media('posters/absoluteflight.jpg'),
    full: media('full/absoluteflight.mp4'),
  },
  {
    key: 'lehimtb',
    title: 'Lehi MTB',
    client: 'Lehi MTB',
    tag: 'Event film',
    year: '2024',
    loop: media('work/lehimtb.mp4'),
    poster: media('posters/lehimtb.jpg'),
    full: media('full/lehimtb.mp4'),
  },
  {
    key: 'ecopoint',
    title: 'EcoPoint',
    client: 'EcoPoint',
    tag: 'Brand film',
    loop: media('work/ecopoint.mp4'),
    poster: media('posters/ecopoint.jpg'),
    full: media('full/ecopoint.mp4'),
  },
  {
    key: 'basicaf',
    title: 'Basic AF',
    client: 'Basic AF',
    tag: 'Documentary series',
    loop: media('work/basicaf.mp4'),
    poster: media('posters/basicaf.jpg'),
    full: media('full/basicaf.mp4'),
  },
];

// Ordered so no two reels from the same brand sit next to each other. The
// natural grouping (all four Basic AF together, both Estates and Exotics
// together) reads as a contact sheet of one shoot rather than a body of work.
// Counts are Basic AF 4, HHC 2, E&E 2, KB 1 across 9 slots, so the four have
// to be spread every other card; anything less even puts two side by side.
// If a reel is added here, re-check the neighbours.
const reels: Reel[] = [
  { key: 'kb-suits',        client: 'Kenneth Boggs / Suits and Supercars', loop: media('social/kb-suits.mp4'),        poster: media('posters/kb-suits.jpg') },
  { key: 'publik-2',        client: 'Basic AF',                            loop: media('social/publik-2.mp4'),        poster: media('posters/publik-2.jpg') },
  { key: 'hhc-farmington',  client: 'Houston TX Hot Chicken / Farmington', loop: media('social/hhc-farmington.mp4'),  poster: media('posters/hhc-farmington.jpg') },
  { key: 'taste-test',      client: 'Basic AF / Taste test',               loop: media('social/taste-test.mp4'),      poster: media('posters/taste-test.jpg') },
  { key: 'ee-obscene',      client: 'Estates and Exotics',                 loop: media('social/ee-obscene.mp4'),      poster: media('posters/ee-obscene.jpg') },
  { key: 'jason-chris',     client: 'Basic AF',                            loop: media('social/jason-chris.mp4'),     poster: media('posters/jason-chris.jpg') },
  { key: 'hhc-stgeorge',    client: 'Houston TX Hot Chicken / St. George', loop: media('social/hhc-stgeorge.mp4'),    poster: media('posters/hhc-stgeorge.jpg') },
  { key: 'publik-basic',    client: 'Basic AF',                            loop: media('social/publik-basic.mp4'),    poster: media('posters/publik-basic.jpg') },
  { key: 'estates-exotics', client: 'Estates and Exotics',                 loop: media('social/estates-exotics.mp4'), poster: media('posters/estates-exotics.jpg') },
];

// The zoom-parallax hero's seven tiles, one frame per client piece. Tile 0
// sits dead centre and scales to exactly fill the viewport, so it is the one
// that carries the montage.
const heroTiles = [
  { src: media('tiles/tile-01.jpg'), alt: '' },
  { src: media('tiles/tile-02.jpg'), alt: '' },
  { src: media('tiles/tile-03.jpg'), alt: '' },
  { src: media('tiles/tile-04.jpg'), alt: '' },
  { src: media('tiles/tile-05.jpg'), alt: '' },
  { src: media('tiles/tile-06.jpg'), alt: '' },
  { src: media('tiles/tile-07.jpg'), alt: '' },
];

// Shown as the hero zoom resolves. Every figure here is defensible: the 1.6B
// is Austin-supplied and confirmed by Ty (see the note above the old stat
// band), and the other two are literally countable on this page -- eight named
// clients across the work grid and the reel rail, and the four-person crew the
// About section names. Nothing invented, per the design system.
const heroStats = [
  { value: '1.6B+', label: 'Views across client content', sub: 'via SHORT CUT, our social arm' },
  { value: '8', label: 'Brands in this reel', sub: 'Commercial, event, documentary' },
  { value: '4', label: 'People, one roof', sub: 'Salt Lake City, UT' },
];

const services = [
  { index: '01', title: 'Video production', description: 'Direction, cinematography, editing, drone. One crew end to end.' },
  { index: '02', title: 'Short Cut / Social', description: 'Our social media arm, SHORT CUT, runs the channels the footage feeds.' },
  { index: '03', title: 'Content strategy', description: 'What to make, for whom, and why, before a camera rolls.' },
];
---
<Base site={content?.site ?? {}}>
  {live ? (
    <SectionRenderer sections={content!.sections} products={content!.products} />
  ) : (
    <Fragment>
      <ZoomHero
        tiles={heroTiles}
        stats={heroStats}
        video={media('hero/hero-loop.mp4')}
        videoSmall={media('hero/hero-loop-720.mp4')}
        videoPoster={media('posters/hero.jpg')}
      >
        <span class="eyebrow">Salt Lake City, UT / Video production + social</span>
        <h1>Video that brings<br />customers. Not just views.</h1>
        <p class="sub hero-sub">
          We shoot cinematic video and run your social channels. One small team, one roof.
        </p>
        <div class="hero-actions">
          <a class="btn" href="#work">See the work</a>
          <a class="btn-ghost" href="#contact">Book a call</a>
        </div>
      </ZoomHero>

      <WorkGrid items={work} />

      <FeaturedFilm
        src={media('featured/carpa-film.mp4')}
        poster={media('posters/carpa-film.jpg')}
        title="An Evening with Carpa"
        client="Short film"
        tag="Directed and shot by VSN CUT"
        blurb="A minute of what a camera can do for a story when nobody is rushing it. Sound on."
      />

      <SocialStrip reels={reels} />

      <section id="services">
        <div class="wrap">
          <div class="heading">
            <span class="eyebrow">Services</span>
            <h2>One team. One roof.</h2>
            <p class="sub">Most studios hand you a file and leave. We shoot it, cut it, and keep your channels moving.</p>
          </div>
          <div class="grid">
            {services.map((s) => (
              <div class="service-card">
                <span class="service-index">{s.index}</span>
                <span class="service-title">{s.title}</span>
                <p>{s.description}</p>
              </div>
            ))}
          </div>
          <p class="cta-row"><a class="btn" href="#contact">Book a call</a></p>
        </div>
      </section>

      <section id="about">
        <div class="wrap">
          <div class="heading">
            <span class="eyebrow">About</span>
            <h2>A small crew in Salt Lake City</h2>
            <p class="sub">
              Austin Schroader directs and shoots. Spencer Reich on camera, Zach Willis on drone,
              Olivia Wise running social. Four people, one roof, no handoffs.
            </p>
          </div>
        </div>
      </section>

      <section id="contact">
        <div class="wrap">
          <div class="heading">
            <span class="eyebrow">Contact</span>
            <h2>Tell us the outcome you need</h2>
            <p class="sub">A call costs nothing. austin@vsncut.com · 801-865-5585 · Salt Lake City, UT</p>
          </div>
          <p class="cta-row"><a class="btn" href="tel:+18018655585">Call 801-865-5585</a></p>
        </div>
      </section>
    </Fragment>
  )}
</Base>

<style>
  .heading { display: flex; flex-direction: column; gap: 14px; margin-bottom: var(--space-7); }

  .hero-sub { margin: 0 auto; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin-top: 10px; }
  .btn-ghost {
    display: inline-flex; align-items: center;
    font-family: var(--font-display); text-transform: uppercase; letter-spacing: .06em;
    font-size: 17px; padding: 12px 24px; line-height: 1.25;
    border: 1px solid var(--border-strong); color: var(--text-body);
    transition: border-color var(--dur-fast) var(--ease-cine), color var(--dur-fast) var(--ease-cine);
  }
  .btn-ghost:hover { border-color: var(--accent); color: var(--accent); }

  .stat-band { text-align: center; }
  .stat-inner { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: center; gap: 12px 28px; }
  .stat-value {
    font-family: var(--font-display); font-size: clamp(64px, 9vw, 120px);
    line-height: .9; text-transform: uppercase; color: var(--accent);
  }
  .stat-label { font-family: var(--font-display); font-size: clamp(24px, 3vw, 40px); line-height: 1; text-transform: uppercase; }
  .stat-sub {
    font-family: var(--font-mono); font-size: 12px; text-transform: uppercase;
    letter-spacing: var(--tracking-caps); color: var(--text-muted); width: 100%;
  }

  .service-card {
    border: 1px solid var(--border-subtle); background: var(--surface-card);
    padding: 28px; display: flex; flex-direction: column; gap: 14px;
    transition: border-color var(--dur-fast) var(--ease-cine);
  }
  .service-card:hover { border-color: var(--border-strong); }
  .service-index { font-family: var(--font-mono); font-size: 12px; color: var(--text-muted); }
  .service-card:hover .service-index { color: var(--accent); }
  .service-title { font-family: var(--font-display); font-size: 30px; text-transform: uppercase; line-height: 1; }
  .service-card p { margin: 0; font-size: 15px; color: var(--text-soft); line-height: 1.6; }
  .cta-row { margin-top: var(--space-7); }
</style>
