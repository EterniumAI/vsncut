---
// Full-bleed film hero. Replaces the placeholder ZoomHero tile grid now that
// there is real footage: a silent 15s montage cut from seven client pieces,
// looping behind the headline.
//
// The poster is what paints for LCP, so it is eager and the video is layered
// over it once it can play. Under prefers-reduced-motion the video never
// starts and the poster IS the hero, which is why the poster has to be a
// frame worth looking at on its own.
interface Props {
  video: string;
  /** Smaller encode for phones. Roughly half the bytes of the 1080p cut. */
  videoSmall?: string;
  poster: string;
}
const { video, videoSmall, poster } = Astro.props;
---
<section class="film-hero" id="top">
  <div class="film-bed">
    <img class="film-poster" src={poster} alt="" width="1920" height="1080" fetchpriority="high" />
    {/* No src attribute on purpose. The script below picks the encode that
        suits the viewport; putting a src here would start the 1080p download
        on phones before the script could ever swap it. With JS off the poster
        is the hero, which is the same thing reduced-motion users get. */}
    <video
      class="film-video"
      data-hero-video
      data-src={video}
      data-src-small={videoSmall ?? video}
      poster={poster}
      muted
      loop
      playsinline
      preload="auto"
      aria-hidden="true"
      tabindex="-1"
    ></video>
    <div class="film-scrim"></div>
    <div class="film-grain"></div>
  </div>

  <div class="film-copy">
    <span class="eyebrow">Salt Lake City, UT / Video production + social</span>
    <h1>Video that brings<br />customers. Not just views.</h1>
    <p class="sub film-sub">
      We shoot cinematic video and run your social channels. One small team, one roof.
    </p>
    <div class="film-actions">
      <a class="btn" href="#work">See the work</a>
      <a class="btn-ghost" href="#contact">Book a call</a>
    </div>
  </div>

  <button class="motion-toggle" type="button" data-motion-toggle aria-pressed="false">
    <span data-motion-label>Pause motion</span>
  </button>

  <a class="film-cue" href="#work" aria-label="Scroll to the work">Scroll</a>
</section>

<style>
  .film-hero {
    position: relative;
    min-height: min(100svh, 900px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--space-9) var(--container-pad);
    border-top: 0;
    overflow: hidden;
    background: var(--black);
  }
  .film-bed { position: absolute; inset: 0; z-index: 0; }
  .film-poster,
  .film-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(.35) contrast(1.06);
  }
  /* The video sits over the poster and fades in only once it is actually
     rolling, so a slow connection shows a still frame, never a black box. */
  .film-video { opacity: 0; transition: opacity var(--dur-slow) var(--ease-cine); }
  .film-video.is-playing { opacity: 1; }

  .film-scrim {
    position: absolute; inset: 0; pointer-events: none;
    background:
      linear-gradient(to bottom, rgba(10,10,11,.72) 0%, rgba(10,10,11,.38) 38%, rgba(10,10,11,.88) 100%);
  }
  .film-grain {
    position: absolute; inset: 0;
    background: var(--grain-url); opacity: var(--grain-opacity); pointer-events: none;
  }

  .film-copy {
    position: relative; z-index: 2;
    display: flex; flex-direction: column; align-items: center; gap: 18px;
    text-align: center; max-width: 1000px;
  }
  .film-sub { margin: 0 auto; }
  .film-actions { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin-top: 10px; }
  .btn-ghost {
    display: inline-flex; align-items: center;
    font-family: var(--font-display); text-transform: uppercase; letter-spacing: .06em;
    font-size: 17px; padding: 12px 24px; line-height: 1.25;
    border: 1px solid var(--border-strong); color: var(--text-body);
    transition: border-color var(--dur-fast) var(--ease-cine), color var(--dur-fast) var(--ease-cine);
  }
  .btn-ghost:hover { border-color: var(--accent); color: var(--accent); }

  /* The single stop control for every auto-playing video on the page. It is a
     real focusable button, not an overlay affordance, because 2.2.2 wants a
     mechanism that keyboard and switch users can actually reach. */
  .motion-toggle {
    position: absolute; z-index: 3; right: var(--container-pad); bottom: 24px;
    font-family: var(--font-mono); font-size: 11px; text-transform: uppercase;
    letter-spacing: var(--tracking-caps); line-height: 1;
    padding: 9px 13px; cursor: pointer;
    background: rgba(10,10,11,.72); color: var(--text-soft);
    border: 1px solid var(--border-strong); border-radius: var(--radius-0);
    transition: color var(--dur-fast) var(--ease-cine), border-color var(--dur-fast) var(--ease-cine);
  }
  .motion-toggle:hover { color: var(--accent); border-color: var(--accent); }
  .motion-toggle:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 2px; }
  /* Nothing is moving under reduced motion, so a stop control would be a lie. */
  @media (prefers-reduced-motion: reduce) { .motion-toggle { display: none; } }

  .film-cue {
    position: absolute; z-index: 2; bottom: 28px; left: 50%; transform: translateX(-50%);
    font-family: var(--font-mono); font-size: 11px; text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow); color: var(--text-muted);
  }
  .film-cue:hover { color: var(--accent); }

  @media (prefers-reduced-motion: reduce) {
    .film-video { display: none; }
  }
  @media (max-width: 820px) {
    .film-hero { min-height: min(88svh, 720px); }
  }
</style>

<script>
  import { motionAllowed, setMotion, onMotionChange, MOTION_EVENT } from '../lib/motion';

  // The toggle is wired first and unconditionally. It is the page's only stop
  // control for decorative motion, so it must work even if the hero video
  // itself never loads.
  const btn = document.querySelector<HTMLButtonElement>('[data-motion-toggle]');
  const label = document.querySelector<HTMLElement>('[data-motion-label]');
  if (btn) {
    btn.addEventListener('click', () => {
      const nowPaused = document.documentElement.dataset.motion !== 'paused';
      setMotion(nowPaused);
      btn.setAttribute('aria-pressed', String(nowPaused));
      if (label) label.textContent = nowPaused ? 'Play motion' : 'Pause motion';
    });
  }

  // Autoplay is a request, not a guarantee: iOS low-power mode and some data
  // savers reject it. The poster stays visible in that case rather than the
  // page sitting on a dead frame, so the failure path is silent and fine.
  const v = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  if (v && motionAllowed()) {
    const small = window.matchMedia('(max-width: 820px)').matches;
    const src = (small ? v.dataset.srcSmall : v.dataset.src) || v.dataset.src;
    if (src) v.src = src;

    const show = () => v.classList.add('is-playing');
    v.addEventListener('playing', show, { once: true });
    const tryPlay = () => { if (motionAllowed()) v.play().catch(() => {}); };
    if (v.readyState >= 2) tryPlay();
    else v.addEventListener('loadeddata', tryPlay, { once: true });

    // Stop decoding while the hero is off screen; it is the most expensive
    // thing on the page and nobody is looking at it past the fold.
    let onScreen = true;
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        ([e]) => { onScreen = e.isIntersecting; if (onScreen) tryPlay(); else v.pause(); },
        { threshold: 0.1 }
      ).observe(v);
    }
    onMotionChange((allowed) => { if (allowed && onScreen) tryPlay(); else v.pause(); });
  } else if (v) {
    // Motion is off from the start, so the poster is the hero. Still let the
    // toggle bring the video in if the user turns motion back on.
    document.addEventListener(MOTION_EVENT, () => {
      if (!motionAllowed()) { v.pause(); return; }
      if (!v.src) {
        const small = window.matchMedia('(max-width: 820px)').matches;
        v.src = (small ? v.dataset.srcSmall : v.dataset.src) || v.dataset.src || '';
      }
      v.classList.add('is-playing');
      v.play().catch(() => {});
    });
  }
</script>
