---
// The portfolio grid. Every card is a real client piece: a poster frame, a
// silent loop that starts on hover or focus, and a watchable excerpt with
// sound behind a native <dialog>.
//
// Loops are preload="none" on purpose. Seven autoplaying videos would cost
// more than the rest of the page combined, so nothing loads until the pointer
// or the viewport asks for it.
import type { WorkItem } from '../lib/media';
interface Props { items: WorkItem[] }
const { items } = Astro.props;
---
<section id="work">
  <div class="wrap">
    <div class="heading">
      <span class="eyebrow">Work / Selected</span>
      <h2>The work speaks first</h2>
      <p class="sub">
        Brand films, event coverage, documentary and paid social. Open any frame to
        watch it with sound.
      </p>
    </div>

    <div class="work-grid">
      {items.map((w) => (
        <article class="work-card" data-card>
          <button
            class="frame"
            type="button"
            data-open={w.full ? w.key : undefined}
            disabled={!w.full}
            aria-label={w.full ? `Play ${w.title}` : w.title}
          >
            <img src={w.poster} alt={w.title} loading="lazy" width="1600" height="900" />
            <video
              class="frame-video"
              data-loop
              src={w.loop}
              muted
              loop
              playsinline
              preload="none"
              aria-hidden="true"
              tabindex="-1"
            ></video>
            <div class="frame-scrim"></div>
            <div class="frame-grain"></div>
            {w.full && <span class="frame-play" aria-hidden="true">Play</span>}
          </button>

          <div class="work-body">
            <div class="work-meta">
              <span class="tag">{w.tag}</span>
              {w.year && <span class="year">{w.year}</span>}
            </div>
            <span class="work-title">{w.title}</span>
            {/* Most pieces are titled after the client, so printing both just
                stutters the same words twice. Show the client only when it
                carries something the title does not. */}
            {w.client && w.client.toLowerCase() !== w.title.toLowerCase() && (
              <span class="work-client">{w.client}</span>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

{items.filter((w) => w.full).map((w) => (
  <dialog class="lightbox" data-dialog={w.key} aria-label={w.title}>
    <button class="lightbox-close" type="button" data-close aria-label="Close">Close</button>
    <video
      data-dialog-video
      src={w.full}
      poster={w.poster}
      controls
      playsinline
      preload="none"
    ></video>
    <div class="lightbox-meta">
      <span class="work-title">{w.title}</span>
      <span class="meta">{[w.client, w.tag].filter(Boolean).join(' / ')}</span>
    </div>
  </dialog>
))}

<style>
  .heading { display: flex; flex-direction: column; gap: 14px; margin-bottom: var(--space-7); }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-5);
  }
  .work-card {
    border: 1px solid var(--border-subtle);
    background: var(--surface-card);
    transition: border-color var(--dur-fast) var(--ease-cine);
  }
  .work-card:hover { border-color: var(--border-strong); }

  .frame {
    position: relative; display: block; width: 100%; padding: 0; margin: 0;
    aspect-ratio: var(--frame-ratio-video);
    overflow: hidden; background: var(--ink-900);
    border: 0; border-radius: var(--radius-0);
    cursor: pointer; font: inherit; color: inherit;
  }
  .frame[disabled] { cursor: default; }
  .frame:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: -2px; }

  .frame img,
  .frame-video {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    filter: grayscale(1) contrast(1.08);
    transition: filter var(--dur-med) var(--ease-cine), opacity var(--dur-med) var(--ease-cine);
  }
  .frame-video { opacity: 0; }
  /* .is-previewing is the touch equivalent of :hover, set by the observer on
     the one card it decided to play. Without it the clip decodes invisibly. */
  .work-card:hover .frame img,
  .work-card.is-previewing .frame img,
  .frame:focus-visible img { filter: grayscale(.15) contrast(1.05); }
  .work-card:hover .frame-video,
  .work-card.is-previewing .frame-video,
  .frame:focus-visible .frame-video { opacity: 1; filter: grayscale(0) contrast(1.03); }

  .frame-grain {
    position: absolute; inset: 0; background: var(--grain-url);
    opacity: var(--grain-opacity); pointer-events: none;
  }
  .frame-scrim { position: absolute; inset: 0; background: var(--scrim-bottom); }
  .frame-play {
    position: absolute; right: 14px; bottom: 14px;
    font-family: var(--font-mono); font-size: 11px; text-transform: uppercase;
    letter-spacing: var(--tracking-caps); line-height: 1;
    padding: 8px 12px; border: 1px solid var(--border-strong);
    background: rgba(10,10,11,.6); color: var(--text-soft);
    transition: color var(--dur-fast) var(--ease-cine), border-color var(--dur-fast) var(--ease-cine);
  }
  .work-card:hover .frame-play { color: var(--accent); border-color: var(--accent); }

  .work-body { padding: 18px; display: flex; flex-direction: column; gap: 10px; }
  .work-meta { display: flex; gap: 8px; align-items: center; }
  .tag {
    font-family: var(--font-mono); font-size: 11px; text-transform: uppercase;
    letter-spacing: var(--tracking-caps); padding: 5px 10px;
    border: 1px solid var(--border-strong); color: var(--text-soft); line-height: 1.2;
  }
  .work-card:hover .tag { border-color: var(--accent); color: var(--accent); }
  .year { font-family: var(--font-mono); font-size: 11px; color: var(--text-muted); }
  .work-title {
    font-family: var(--font-display); font-size: 26px; line-height: 1; text-transform: uppercase;
  }
  .work-client {
    font-family: var(--font-mono); font-size: 11px; text-transform: uppercase;
    letter-spacing: var(--tracking-caps); color: var(--text-muted);
  }

  .lightbox {
    width: min(1100px, 92vw); padding: 0; border: 1px solid var(--border-strong);
    background: var(--ink-900); color: var(--text-body); border-radius: var(--radius-0);
  }
  .lightbox::backdrop { background: rgba(10,10,11,.9); }
  .lightbox video { width: 100%; aspect-ratio: var(--frame-ratio-video); background: var(--black); display: block; }
  .lightbox-meta { padding: 16px 18px; display: flex; flex-direction: column; gap: 6px; }
  .lightbox-close {
    position: absolute; top: 10px; right: 10px; z-index: 2;
    font-family: var(--font-mono); font-size: 11px; text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    background: rgba(10,10,11,.75); color: var(--text-soft);
    border: 1px solid var(--border-strong); padding: 8px 12px; cursor: pointer;
  }
  .lightbox-close:hover { color: var(--accent); border-color: var(--accent); }

  @media (prefers-reduced-motion: reduce) {
    .frame-video { display: none; }
  }
</style>

<script>
  import { motionAllowed, onMotionChange } from '../lib/motion';

  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-card]'));
  const loopOf = (c: Element) => c.querySelector<HTMLVideoElement>('[data-loop]');

  const pauseAll = () => cards.forEach((c) => {
    loopOf(c)?.pause();
    c.classList.remove('is-previewing');
  });

  // Hover/focus preview. Touch devices get no hover, so the loop is driven by
  // the viewport there instead (below) and the tap opens the real player.
  document.querySelectorAll<HTMLElement>('[data-card]').forEach((card) => {
    const v = loopOf(card);
    if (!v) return;
    const start = () => { if (motionAllowed()) v.play().catch(() => {}); };
    const stop = () => { v.pause(); };
    card.addEventListener('pointerenter', start);
    card.addEventListener('pointerleave', stop);
    card.addEventListener('focusin', start);
    card.addEventListener('focusout', stop);
  });

  // Coarse pointers get no hover, so the viewport drives the preview. Exactly
  // ONE card plays: the one nearest the middle of the screen.
  //
  // Playing every intersecting card instead (the obvious IntersectionObserver
  // shape) is a real cost, not a style question. On a phone the grid is one
  // column, so an ordinary scroll crosses all seven cards and play() overrides
  // preload="none" on each, pulling ~13.8MB. Worse, .frame-video only becomes
  // visible on :hover / :focus-visible, neither of which a touch scroll can
  // trigger, so all of it decodes underneath an opaque poster for no visible
  // motion at all. Hence both halves of the fix: pick one card, and mark it
  // .is-previewing so the clip the user paid for is the clip they see.
  if (window.matchMedia('(hover: none)').matches && 'IntersectionObserver' in window) {
    const visible = new Set<Element>();
    let current: Element | null = null;

    const settle = () => {
      if (!motionAllowed()) { pauseAll(); current = null; return; }
      const mid = window.innerHeight / 2;
      let best: Element | null = null;
      let bestDist = Infinity;
      visible.forEach((el) => {
        const r = el.getBoundingClientRect();
        const d = Math.abs(r.top + r.height / 2 - mid);
        if (d < bestDist) { bestDist = d; best = el; }
      });
      if (best === current) return;
      if (current) {
        loopOf(current)?.pause();
        current.classList.remove('is-previewing');
      }
      current = best;
      if (current) {
        current.classList.add('is-previewing');
        loopOf(current)?.play().catch(() => {});
      }
    };

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) visible.add(e.target);
          else {
            visible.delete(e.target);
            loopOf(e.target)?.pause();
            e.target.classList.remove('is-previewing');
          }
        });
        settle();
      },
      { threshold: 0.6 }
    );
    cards.forEach((c) => io.observe(c));
    window.addEventListener('scroll', () => { requestAnimationFrame(settle); }, { passive: true });
  }

  onMotionChange((allowed) => { if (!allowed) pauseAll(); });

  // Lightbox. <dialog> gives focus trapping and Esc for free; all that is left
  // is pausing on close so audio never outlives the modal.
  document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.getAttribute('data-open');
      const dlg = document.querySelector<HTMLDialogElement>(`[data-dialog="${key}"]`);
      if (!dlg) return;
      dlg.showModal();
      const v = dlg.querySelector<HTMLVideoElement>('[data-dialog-video]');
      v?.play().catch(() => {});
    });
  });
  document.querySelectorAll<HTMLDialogElement>('[data-dialog]').forEach((dlg) => {
    const v = dlg.querySelector<HTMLVideoElement>('[data-dialog-video]');
    const shut = () => dlg.close();
    dlg.querySelector('[data-close]')?.addEventListener('click', shut);
    // Click on the backdrop (the dialog element itself, outside its content).
    dlg.addEventListener('click', (e) => { if (e.target === dlg) shut(); });
    dlg.addEventListener('close', () => { if (v) { v.pause(); v.currentTime = 0; } });
  });
</script>
