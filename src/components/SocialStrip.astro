---
// SHORT CUT: the vertical social arm. A horizontal rail of 9:16 reels that
// play muted when scrolled into view and unmute on tap, which is the only
// interaction pattern people already know from the feeds this work ships to.
//
// This section carries data-brand-scope="shortcut", so every accent inside it
// resolves to the red/orange sub-brand instead of the yellow house accent.
// That token swap is the whole reason the scope attribute exists.
import type { Reel } from '../lib/media';
interface Props { reels: Reel[] }
const { reels } = Astro.props;
---
<section id="short-cut" data-brand-scope="shortcut" data-social>
  <div class="social-track" data-track>
    <div class="social-pin" data-pin>
      <div class="wrap">
        <div class="heading">
          <span class="eyebrow">Short Cut / Social</span>
          <h2>Built for the feed</h2>
          <p class="sub">
            SHORT CUT is our social arm. Vertical, sound on, cut to hold attention in the
            first second. Tap any reel for audio.
          </p>
        </div>
      </div>

      <div class="rail" data-rail>
    {/* Each card is a toggle, so it needs aria-pressed. The visible
        "Sound on/off" chip is swapped by script, but an aria-label beats
        name-from-content in the accname algorithm, so without aria-pressed
        nothing about the state ever reaches a screen reader. */}
    {reels.map((r) => (
      <button
        class="reel-card"
        type="button"
        data-reel
        aria-pressed="false"
        aria-label={`Sound for the ${r.client} reel`}
      >
        <video
          data-reel-video
          src={r.loop}
          poster={r.poster}
          muted
          loop
          playsinline
          preload="none"
        ></video>
        <div class="reel-grain"></div>
        <span class="reel-client">{r.client}</span>
        <span class="reel-audio" data-audio-flag>Sound off</span>
      </button>
    ))}
      </div>

      <div class="rail-progress" aria-hidden="true"><span data-rail-progress></span></div>
    </div>
  </div>
</section>

<style>
  .heading { display: flex; flex-direction: column; gap: 14px; margin-bottom: var(--space-7); }

  /* Default is a plain section with a natively swipeable rail. That is what
     ships with JS off and under reduced motion, and it is fully usable.
     The pinned mode below is added by script only when there is actually
     something off-screen to reveal. */
  .social-track { position: relative; }
  .social-pin { display: block; }

  /* Pinned mode: the section holds the viewport for a stretch of scroll, and
     that vertical distance drives the rail sideways, so the reels cannot be
     scrolled past without being seen. Height is set inline from the real
     overflow width, because hardcoding it would either strand the last reel
     or leave dead scroll after it. */
  [data-social].is-pinned .social-pin {
    position: sticky; top: 0; height: 100svh;
    /* Clears the sticky nav, which otherwise crops the eyebrow off the top of
       the heading for the whole time the section is held. */
    padding-top: var(--nav-h);
    display: flex; flex-direction: column; justify-content: center;
    overflow: hidden;
  }
  [data-social].is-pinned .rail {
    /* The vertical scroll is the control now, so the bar would just be noise,
       and snap points fight a programmatically driven scrollLeft. */
    scroll-snap-type: none;
    scrollbar-width: none;
  }
  [data-social].is-pinned .rail::-webkit-scrollbar { display: none; }

  .rail-progress {
    height: 1px; background: var(--border-subtle); position: relative;
    margin: var(--space-5) var(--container-pad) 0;
  }
  .rail-progress span {
    position: absolute; inset: 0 auto 0 0; width: 0%;
    background: var(--accent); transition: width 90ms linear;
  }
  [data-social]:not(.is-pinned) .rail-progress { display: none; }

  .rail {
    display: flex; gap: var(--space-4);
    overflow-x: auto; overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    padding: 0 var(--container-pad) var(--space-3);
    /* Without this the snapport is the padding box, so the browser snaps the
       first card by scrolling exactly one gutter and the rail starts flush to
       the viewport edge, out of line with the heading above it. */
    scroll-padding-left: var(--container-pad);
    scrollbar-width: thin;
  }
  .reel-card {
    position: relative; flex: 0 0 auto;
    width: clamp(200px, 46vw, 268px); aspect-ratio: 9 / 16;
    scroll-snap-align: start;
    background: var(--ink-900); border: 1px solid var(--border-subtle);
    border-radius: var(--radius-0); padding: 0; overflow: hidden;
    cursor: pointer; font: inherit; color: inherit;
    transition: border-color var(--dur-fast) var(--ease-cine);
  }
  .reel-card:hover { border-color: var(--accent); }
  .reel-card:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: -2px; }
  .reel-card video {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
  }
  .reel-grain {
    position: absolute; inset: 0; background: var(--grain-url);
    opacity: var(--grain-opacity); pointer-events: none;
  }
  .reel-client {
    position: absolute; left: 12px; bottom: 12px; max-width: calc(100% - 24px);
    font-family: var(--font-mono); font-size: 10px; text-transform: uppercase;
    letter-spacing: var(--tracking-caps); line-height: 1.2; text-align: left;
    padding: 7px 10px; background: rgba(10,10,11,.85);
    border: 1px solid var(--border-strong); color: var(--text-soft);
  }
  /* This chip is the only text carrying mute state and it sits directly on
     video with no section scrim, so 28% of every frame used to composite
     through a --text-muted label: 8 of the 9 shipped reels failed 4.5:1, the
     brightest at 2.8. Its sibling .reel-client already used --text-soft on the
     same backing and cleared everywhere, so this matches it and darkens the
     plate enough to hold across the footage. */
  .reel-audio {
    position: absolute; right: 12px; top: 12px;
    font-family: var(--font-mono); font-size: 10px; text-transform: uppercase;
    letter-spacing: var(--tracking-caps); line-height: 1;
    padding: 6px 9px; background: rgba(10,10,11,.88);
    border: 1px solid var(--border-strong); color: var(--text-soft);
  }
  .reel-card.is-live .reel-audio { color: var(--accent); border-color: var(--accent); }

  @media (max-width: 820px) {
    .rail { padding-left: 20px; padding-right: 20px; scroll-padding-left: 20px; }
  }
</style>

<script>
  import { motionAllowed, onMotionChange } from '../lib/motion';

  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-reel]'));

  // ── the rail scrolls sideways as you scroll down ────────────────────────
  //
  // The section pins for a stretch of vertical scroll and that distance is
  // mapped onto the rail's horizontal overflow, so every reel passes through
  // the viewport instead of being scrolled past in a strip most people never
  // touch. scrollLeft is driven rather than a transform, so the rail stays a
  // real scroll container: swiping it directly still works, and it degrades to
  // an ordinary horizontal scroller the moment this is switched off.
  const section = document.querySelector<HTMLElement>('[data-social]');
  const track = document.querySelector<HTMLElement>('[data-track]');
  const pin = document.querySelector<HTMLElement>('[data-pin]');
  const rail = document.querySelector<HTMLElement>('[data-rail]');
  const bar = document.querySelector<HTMLElement>('[data-rail-progress]');
  const reduceMQ = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (section && track && pin && rail) {
    let maxScroll = 0;
    let raf: number | null = null;

    const measure = () => {
      // Unpin first so the rail reports its natural overflow, not last run's.
      section.classList.remove('is-pinned');
      track.style.height = '';
      maxScroll = rail.scrollWidth - rail.clientWidth;

      // Nothing hidden, or the user asked for less motion: stay a plain rail.
      if (maxScroll < 24 || reduceMQ.matches) {
        rail.scrollLeft = 0;
        if (bar) bar.style.width = '0%';
        return;
      }
      section.classList.add('is-pinned');
      // Pace it to the content: a little over 1px of page scroll per px of
      // rail travel reads as deliberate rather than frantic.
      track.style.height = `calc(100svh + ${Math.round(maxScroll * 1.15)}px)`;
      apply();
    };

    const apply = () => {
      raf = null;
      if (!section.classList.contains('is-pinned')) return;
      const r = track.getBoundingClientRect();
      const total = r.height - pin.getBoundingClientRect().height;
      if (total <= 0) return;
      const p = Math.min(1, Math.max(0, -r.top / total));
      rail.scrollLeft = p * maxScroll;
      if (bar) bar.style.width = `${Math.round(p * 100)}%`;
    };

    const schedule = () => { if (!raf) raf = requestAnimationFrame(apply); };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', () => { measure(); }, { passive: true });
    reduceMQ.addEventListener('change', measure);
    // Card widths depend on fonts and the poster images, so measure once those
    // have settled rather than trusting the first layout pass.
    if (document.readyState === 'complete') measure();
    else window.addEventListener('load', measure, { once: true });
    measure();
  }
  const videoOf = (c: Element) => c.querySelector<HTMLVideoElement>('[data-reel-video]');

  // Only the reels actually on screen decode. Without this the rail would keep
  // nine 1080-tall videos alive at once on a phone. Unlike the work grid this
  // is a horizontal rail, so at most two or three are ever on screen and
  // playing all of them is the right behaviour.
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          const v = videoOf(e.target);
          if (!v) return;
          if (e.isIntersecting && motionAllowed()) v.play().catch(() => {});
          else v.pause();
        });
      },
      { threshold: 0.35 }
    );
    cards.forEach((c) => io.observe(c));
  }

  onMotionChange((allowed) => {
    cards.forEach((c) => { if (!allowed) videoOf(c)?.pause(); });
  });

  // Tap to unmute. Only one reel is ever audible, so tapping a second one
  // silences the first rather than stacking two soundtracks.
  const setAudioState = (card: Element, on: boolean) => {
    const v = videoOf(card);
    const flag = card.querySelector<HTMLElement>('[data-audio-flag]');
    if (!v) return;
    v.muted = !on;
    card.classList.toggle('is-live', on);
    card.setAttribute('aria-pressed', String(on));
    if (flag) flag.textContent = on ? 'Sound on' : 'Sound off';
  };

  cards.forEach((card) => {
    card.addEventListener('click', () => {
      const v = videoOf(card);
      if (!v) return;
      const turningOn = v.muted;
      cards.forEach((other) => setAudioState(other, false));
      if (turningOn) {
        setAudioState(card, true);
        // Unmuting is a user gesture, so play here even if motion is paused:
        // they explicitly asked for this one reel.
        v.play().catch(() => {});
      }
    });
  });
</script>
