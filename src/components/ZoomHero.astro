---
// The signature scroll-driven zoom-parallax hero, ported from the design
// system's ZoomHero.jsx. A 300vh scroll container with a sticky viewport; up to
// 7 tiles scale from 1 to [4,5,6,5,6,8,9] as you scroll, while the overlay
// copy fades out.
//
// Deliberately vanilla: the source is already a hand-rolled rAF recreation of
// the client's framer-motion reference, so there is no motion library to pull
// in. Bails out entirely under prefers-reduced-motion, leaving a static frame.
const { images = [] } = Astro.props;
const SCALES = [4, 5, 6, 5, 6, 8, 9];
const LAYOUTS = [
  { top: '0',     left: '0',       w: '25vw', h: '25vh' },
  { top: '-30vh', left: '5vw',     w: '35vw', h: '30vh' },
  { top: '-10vh', left: '-25vw',   w: '20vw', h: '45vh' },
  { top: '0',     left: '27.5vw',  w: '25vw', h: '25vh' },
  { top: '27.5vh',left: '5vw',     w: '20vw', h: '25vh' },
  { top: '27.5vh',left: '-22.5vw', w: '30vw', h: '25vh' },
  { top: '22.5vh',left: '25vw',    w: '15vw', h: '15vh' },
];
const tiles = images.slice(0, 7);
---
<div class="zoom" data-zoom id="top">
  <div class="zoom-sticky">
    {tiles.map((img: any, i: number) => {
      const L = LAYOUTS[i % LAYOUTS.length];
      return (
        <div class="zoom-tile" data-tile data-scale={SCALES[i % SCALES.length]}>
          <div class="zoom-frame" style={`width:${L.w};height:${L.h};top:${L.top};left:${L.left}`}>
            <img src={img.src} alt={img.alt ?? ''} loading={i === 0 ? 'eager' : 'lazy'} />
            <div class="zoom-grain"></div>
          </div>
        </div>
      );
    })}
    <div class="zoom-overlay" data-overlay>
      <slot />
    </div>
  </div>
</div>

<style>
  .zoom { position: relative; height: 300vh; }
  .zoom-sticky {
    position: sticky; top: 0; height: 100vh; overflow: hidden; background: var(--black);
  }
  .zoom-tile {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    will-change: transform;
  }
  .zoom-frame { position: relative; overflow: hidden; }
  .zoom-frame img {
    width: 100%; height: 100%; object-fit: cover;
    filter: grayscale(1) contrast(1.1);
  }
  .zoom-grain {
    position: absolute; inset: 0;
    background: var(--grain-url); opacity: var(--grain-opacity);
    pointer-events: none;
  }
  .zoom-overlay {
    position: absolute; inset: 0; z-index: 2;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; padding: 0 24px; pointer-events: none;
    background: radial-gradient(ellipse at center, rgba(10,10,11,.55), rgba(10,10,11,.15));
  }
  .zoom-overlay :global(a) { pointer-events: auto; }
  @media (prefers-reduced-motion: reduce) {
    .zoom { height: 100vh; }
  }
</style>

<script>
  const root = document.querySelector('[data-zoom]');
  if (root && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const tiles = Array.from(root.querySelectorAll('[data-tile]'));
    const overlay = root.querySelector('[data-overlay]');
    let raf = null;
    const tick = () => {
      raf = null;
      const r = root.getBoundingClientRect();
      const total = r.height - window.innerHeight;
      if (total <= 0) return;
      const p = Math.min(1, Math.max(0, -r.top / total));
      tiles.forEach((t) => {
        const target = Number(t.dataset.scale || 1);
        t.style.transform = `scale(${1 + p * (target - 1)})`;
      });
      if (overlay) overlay.style.opacity = String(Math.max(0, 1 - p * 2.2));
    };
    window.addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(tick); }, { passive: true });
    window.addEventListener('resize', () => { if (!raf) raf = requestAnimationFrame(tick); }, { passive: true });
    tick();
  }
</script>
